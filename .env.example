FIREBASE_CREDENTIALS_PATH=config/firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_ADMIN_UIDS=
CUSTOMER_ID_HMAC_KEY=
FLASK_HOST=127.0.0.1
PORT=5000
# Set both paths to a trusted local TLS certificate and private key for LAN testing.
FLASK_TLS_CERT_FILE=
FLASK_TLS_KEY_FILE=
# Set only behind a trusted HTTPS reverse proxy; firewall Flask so clients reach it through that proxy.
TRUSTED_PROXY_HOPS=0
# Temporary Cloudflare Quick Tunnel customer-only demo; leave disabled otherwise.
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_URL=
QR_BASE_URL=
# Opens /admin directly only in local debug mode; never enables remote access.
ENABLE_LOCAL_ADMIN_BYPASS=false
# Set to this computer's real LAN IPv4 and Flask port; do not use localhost.
CUSTOMER_QR_BASE_URL=
# IANA timezone used to group analytics days (defaults to UTC when unset).
RESTAURANT_TIMEZONE=UTC
# Optional ISO 4217 currency code for analytics values (for example, INR).
RESTAURANT_CURRENCY=

